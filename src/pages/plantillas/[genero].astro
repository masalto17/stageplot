---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PLANTILLAS_SEO, SLUGS_PLANTILLA_SEO } from '@/data/plantillasSeo';

export function getStaticPaths() {
  return SLUGS_PLANTILLA_SEO.map((slug) => ({ params: { genero: slug } }));
}

const { genero } = Astro.params;
const entrada = PLANTILLAS_SEO[genero!];
if (!entrada) throw new Error(`Genero desconocido: ${genero}`);

const inicio = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site);
const crearConPlantilla = `${inicio}crear/#p=${entrada.slug}`;
const crearVacio = `${inicio}crear/`;
const titulo = `${entrada.h1} - MasAlto StagePlot`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: entrada.h1,
      description: entrada.descripcion,
      inLanguage: 'es-AR',
      url: url.href,
      isPartOf: {
        '@type': 'WebSite',
        name: 'MasAlto StagePlot',
        url: new URL(inicio, Astro.site).href,
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'MasAlto StagePlot',
      applicationCategory: 'DesignApplication',
      operatingSystem: 'Web browser',
      description:
        'Editor gratuito de stage plots e input lists para bandas y sonidistas. Iconos precargados, canales automaticos, export PDF, compartir por link.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'ARS',
      },
      url: `${new URL(inicio, Astro.site).href}crear/`,
      inLanguage: ['es-AR', 'en'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: entrada.faq.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(inicio, Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Plantillas', item: new URL(`${inicio}plantillas/`, Astro.site).href },
        { '@type': 'ListItem', position: 3, name: entrada.nombre, item: url.href },
      ],
    },
  ],
};
---

<BaseLayout title={titulo} description={entrada.descripcion} ogSlug={`plantilla-${entrada.slug}`}>
  <script
    slot="head-extra"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <article class="ma-plantilla">
    <header class="ma-plantilla__header ma-contenedor">
      <p class="ma-guia__migas ma-dato">
        <a href={inicio}>Inicio</a> /
        <a href={`${inicio}plantillas/`}>Plantillas</a> /
        <span>{entrada.nombre}</span>
      </p>
      <h1>{entrada.h1}</h1>
      <p class="ma-guia__lead">{entrada.lead}</p>
      <p class="ma-plantilla__stats ma-dato">
        {entrada.incluye.length} elementos &middot; {entrada.canales} canales aproximados &middot; PDF listo en 3 minutos
      </p>
      <div class="ma-hero__acciones">
        <a class="ma-boton" href={crearConPlantilla}>Usar esta plantilla</a>
        <a class="ma-boton ma-boton--secundario" href={crearVacio}>Empezar de cero</a>
      </div>
    </header>

    <div class="ma-plantilla__cuerpo ma-contenedor">
      <section>
        {entrada.parrafos.map((p) => <p>{p}</p>)}
      </section>

      <section class="ma-plantilla__grid">
        <div>
          <h2>Que incluye</h2>
          <ul>
            {entrada.incluye.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div>
          <h2>Sirve para</h2>
          <ul>
            {entrada.cubre.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </section>

      <section>
        <h2>Preguntas frecuentes sobre {entrada.nombre.toLowerCase()}</h2>
        {entrada.faq.map((f) => (
          <div class="ma-guia__faq">
            <h3>{f.pregunta}</h3>
            <p>{f.respuesta}</p>
          </div>
        ))}
      </section>

      <aside class="ma-guia__cta">
        <h2>Arma el rider de tu {entrada.nombre.toLowerCase()}</h2>
        <p>
          Empeza desde esta plantilla, edita los canales, exporta el PDF y
          compartilo por WhatsApp o mail. Sin registro. Gratis.
        </p>
        <div class="ma-hero__acciones">
          <a class="ma-boton" href={crearConPlantilla}>Usar esta plantilla</a>
          <a class="ma-boton ma-boton--secundario" href={crearVacio}>Empezar de cero</a>
        </div>
      </aside>

      <section class="ma-plantilla__relacionadas">
        <h2>Guias que ayudan</h2>
        <ul>
          <li><a href={`${inicio}guias/como-armar-un-stage-plot/`}>Como armar un stage plot: guia completa</a></li>
          <li><a href={`${inicio}guias/que-es-input-list/`}>Input list: que es y por que la pide el sonidista</a></li>
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
