---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SLUGS_PLANTILLA } from '@/lib/plantilla';

/**
 * Landing por genero. Un click en "Usar esta plantilla" abre /crear con el
 * slug en el hash (`#p=<slug>`). Se usa hash, no query, para que el Service
 * Worker devuelva `/crear/index.html` desde el cache sin variar la key.
 */
const NOMBRES: Record<string, string> = {
  rock: 'Banda de rock',
  solista: 'Solista',
  dj: 'DJ',
  folklore: 'Folklore',
};

const DESCRIPCIONES: Record<string, string> = {
  rock: 'Bateria, bajo, guitarra, teclado, voz principal y coros. Punto de partida clasico.',
  solista: 'Voz principal + guitarra acustica. Setup minimo para un cantautor.',
  dj: 'Cabina DJ + MC + monitores + in-ear. Base para un set electronico.',
  folklore: 'Dos voces + guitarras acusticas + percusion (bongo, cajon).',
};

export function getStaticPaths() {
  return SLUGS_PLANTILLA.map((slug) => ({ params: { genero: slug } }));
}

const { genero } = Astro.params;
const nombre = NOMBRES[genero!] ?? genero!;
const descripcion = DESCRIPCIONES[genero!] ?? '';
const crear = `${import.meta.env.BASE_URL}crear/#p=${genero}`;
---

<BaseLayout
  title={`Stage plot para ${nombre} - MasAlto StagePlot`}
  description={`Plantilla de stage plot y lista de canales para ${nombre}.`}
>
  <section class="ma-hero ma-contenedor">
    <h1>Stage plot para {nombre}</h1>
    <p>{descripcion}</p>
    <div class="ma-hero__acciones">
      <a class="ma-boton" href={crear}>Usar esta plantilla</a>
      <a class="ma-boton ma-boton--secundario" href={`${import.meta.env.BASE_URL}crear/`}>Empezar de cero</a>
    </div>
  </section>
</BaseLayout>
