---
import { Image } from 'astro:assets';
import logoColor from '@/assets/brand/MasAlto_Producciones_Color_Fondo_Claro.png';
import { SITIO_INDEXABLE } from '@/config';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Las herramientas internas no se indexan. */
  noindex?: boolean;
  /** Slug del OG image en `public/og/<slug>.png`. Default: "default". */
  ogSlug?: string;
}

const { title, description, noindex = false, ogSlug = 'default' } = Astro.props;
const sinIndexar = noindex || !SITIO_INDEXABLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImagen = new URL(`${import.meta.env.BASE_URL}og/${ogSlug}.png`, Astro.site);
const inicio = import.meta.env.BASE_URL;
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {sinIndexar && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#E30613" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="MasAlto StagePlot" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImagen.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImagen.href} />
    <link rel="alternate" hreflang="es-AR" href={canonical.href} />
    <link rel="alternate" hreflang="x-default" href={canonical.href} />
    <link rel="icon" type="image/png" href={`${inicio}favicon.png`} />
    <link
      rel="apple-touch-icon"
      href={`${inicio}icons/apple-touch-icon-180x180.png`}
    />
    <link rel="manifest" href={`${inicio}manifest.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Nunito+Sans:wght@400;600;700&display=swap"
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': `${Astro.site?.href}#organization`,
            name: 'MasAlto Producciones',
            url: Astro.site?.href,
            logo: `${Astro.site?.href}${inicio.slice(1)}icons/pwa-512x512.png`,
          },
          {
            '@type': 'WebSite',
            '@id': `${Astro.site?.href}#website`,
            name: 'MasAlto StagePlot',
            url: `${Astro.site?.href ?? ''}${inicio}`.replace(/\/+$/, '/'),
            inLanguage: 'es-AR',
            publisher: { '@id': `${Astro.site?.href}#organization` },
          },
        ],
      })}
    />
    <slot name="head-extra" />
  </head>
  <body>
    <header class="ma-header">
      <div class="ma-contenedor ma-header__interior">
        <a href={inicio} aria-label="MasAlto Producciones - inicio">
          <Image
            class="ma-logo"
            src={logoColor}
            alt="MasAlto Producciones"
            widths={[220, 440]}
            sizes="220px"
            loading="eager"
          />
        </a>
        <span class="ma-dato" aria-hidden="true">StagePlot</span>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="ma-footer">
      <div class="ma-contenedor">
        <p>MasAlto Producciones &middot; {anio}</p>
      </div>
    </footer>

    <script is:inline define:vars={{ inicio }}>
      // Registro del Service Worker. El scope tiene que ser la subruta completa
      // o el SW no controla /stageplot/.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${inicio}sw.js`, { scope: inicio })
            .catch((error) => console.error('SW no registrado:', error));
        });
      }
    </script>
  </body>
</html>
